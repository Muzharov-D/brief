#!/bin/bash
# brief: личный ассистент. Справка: brief
SELF="$0"; while [ -L "$SELF" ]; do L="$(readlink "$SELF")"; case "$L" in /*) SELF="$L";; *) SELF="$(dirname "$SELF")/$L";; esac; done
DIR="$(cd "$(dirname "$SELF")" && pwd)"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export LANG="${LANG:-ru_RU.UTF-8}"
PY="${BRIEF_HOME:-$HOME/.brief}/venv/bin/python"; [ -x "$PY" ] || PY="$(command -v python3)"
exec "$PY" -I "$DIR/brief.py" "$@"
